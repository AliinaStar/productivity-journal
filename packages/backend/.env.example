# === Database ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=reporting_system

# === LLM ===
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o
EVAL_MODEL=gpt-4o-mini
EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base
EMBEDDING_DIMENSIONS=768

# === Email (Resend) ===
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# === Auth (JWT) ===
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_MAX_ATTEMPTS=5

# === App ===
# APP_ENV=production is the secure default; use "development" only locally
# (it enables /auth/dev-login, which bypasses OTP).
APP_ENV=development
LOG_LEVEL=DEBUG
# Optional: write structured logs to a file instead of stdout
LOG_FILE=
CORS_ORIGINS=["http://localhost:3000"]

# === Observability (Langfuse) ===
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# === Backups (production only) ===
# Host directory holding the local dumps. Must live on an encrypted disk.
BACKUP_DIR=/var/backups/litopys

# Encrypts every dump with AES256. REQUIRED in production — dumps contain
# users' journal entries. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Store it in a password manager: lose it and the backups are unreadable.
BACKUP_GPG_PASSPHRASE=

# Schedules (UTC, standard cron syntax).
BACKUP_CRON=17 3 * * *
# Weekly restore rehearsal into a throwaway database. An untested backup is
# not a backup, so this runs on its own without anyone remembering to.
BACKUP_VERIFY_CRON=41 4 * * 1

# How many dumps each local set keeps.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_KEEP_ADHOC=10

# --- Off-site copy (Backblaze B2) ---
# Empty = local backups only. Fill the two keys below FIRST, then set the
# remote — an upload that fails makes the run exit non-zero, which aborts
# the deploy pipeline. Create a bucket + application key at backblaze.com.
RCLONE_CONFIG_OFFSITE_TYPE=b2
# ACCOUNT is the keyID of the application key, not the account ID.
RCLONE_CONFIG_OFFSITE_ACCOUNT=
RCLONE_CONFIG_OFFSITE_KEY=
# B2 deletes are "hide" by default: the old dump stops being listed but is
# still stored and still billed forever. Without this, the age-based prune
# below frees nothing.
RCLONE_CONFIG_OFFSITE_HARD_DELETE=true
# BACKUP_OFFSITE_REMOTE=offsite:your-bucket-name/litopys
BACKUP_OFFSITE_REMOTE=
BACKUP_OFFSITE_KEEP_DAYS=90

# Optional dead-man's switch (healthchecks.io or similar): pinged only after
# a fully clean run, so silence means the backup stopped working.
BACKUP_HEALTHCHECK_URL=
